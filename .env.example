# Copy to .env and fill values from the existing External ID tenant.
# ASP.NET Core does not automatically load .env; see the implementation spec.
# These are server-side keys, not VITE_ frontend configuration.
ExternalId__TenantName=your-existing-external-id-tenant
ExternalId__TenantId=
ExternalId__Authority=
ExternalId__Issuer=
ExternalId__WebClientId=
ExternalId__ApiClientId=
ExternalId__ApiAudience=
# Comma-separated application/client IDs for VS Code, Copilot App, and Claude Code.
# These public IDs identify integrations, not users; keep them environment-configured.
ExternalId__PublicClientIds=
# Copilot App's OAuth Client ID must also be configured in that client; it cannot read this server environment.
Database__ConnectionString=
Azure__HostingTenantId=
Azure__UseManagedIdentity=false
Azure__DataProtectionKeyUri=
Azure__WebClientSecretUri=
Application__PublicBaseUrl=https://localhost:7143
# Put ExternalId:WebClientSecret in ASP.NET User Secrets locally, not in this template.
Application__SelfServiceEnabled=false
Application__RequestPermitLimit=120
Application__RequestConcurrencyLimit=4
Application__CreationPermitLimit=10
Application__RateWindowSeconds=60
