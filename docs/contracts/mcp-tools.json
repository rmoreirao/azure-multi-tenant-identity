    {
      "name": "identity_probe",
      "description": "Checks authenticated MCP connectivity. Returns no company data and makes no task or permission changes.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "taskAuthorizationImplemented": {
            "type": "boolean"
          }
        },
        "required": [
          "authenticated",
          "stage",
          "taskAuthorizationImplemented"
        ]
      },
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      }
    },
    {
      "name": "update_task",
      "description": "Edits one task using its exact current version. Null title/description mean unchanged; replaceAssignee=false preserves even an inactive assignment. Set replaceAssignee=true with null assignee to clear it. Never silently retry a version conflict.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "teamId": {
            "type": "string",
