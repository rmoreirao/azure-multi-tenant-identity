          "title": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "replaceAssignee": {
            "type": "boolean",
            "default": false
          },
          "assigneeMembershipId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          }
        },
        "required": [
          "companyId",
          "teamId",
          "taskId",
          "expectedVersion"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "boardId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "assigneeMembershipId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "assigneeName": {
            "type": [
              "string",
              "null"
            ]
          },
          "assigneeState": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
