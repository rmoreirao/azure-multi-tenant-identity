          "assigneeName": {
            "type": [
              "string",
              "null"
            ]
          },
          "assigneeState": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "companyId",
          "teamId",
          "boardId",
          "title",
          "description",
          "status",
          "assigneeMembershipId",
          "assigneeName",
          "assigneeState",
          "createdAt",
          "updatedAt",
          "version"
        ]
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      }
