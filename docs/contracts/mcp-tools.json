          "assigneeName",
          "assigneeState",
          "createdAt",
          "updatedAt",
          "version"
        ]
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      }
    },
    {
      "name": "create_task",
      "description": "Creates one To do task. Supply a 16-128 ASCII-character idempotency key and reuse it with identical content after an uncertain result; deduplication lasts 24 hours. An assignee must be an active team contributor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "assigneeMembershipId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          }
        },
        "required": [
          "companyId",
          "teamId",
          "title",
          "idempotencyKey"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "taskId",
          "version",
          "createdAt"
        ]
      },
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      }
    },
    {
      "name": "list_teams",
      "description": "Lists the current employee\u0027s permitted teams within an approved company connection. Company IDs select context, not authority.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "limit": {
            "type": "integer",
            "default": 50
          }
        },
        "required": [
          "companyId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "integer"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "role",
                "version"
              ]
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      }
    },
